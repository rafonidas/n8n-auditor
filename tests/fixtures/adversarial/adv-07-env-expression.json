{
  "name": "Env-based auth",
  "id": "wf-adv-07",
  "active": false,
  "settings": {},
  "nodes": [
    { "id": "n1", "name": "Manual Trigger", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 0], "parameters": {} },
    {
      "id": "n2", "name": "Authorized call", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [200, 0],
      "retryOnFail": true,
      "parameters": {
        "url": "https://api.fakevendor.io/v1/items",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.VENDOR_API_KEY }}" },
            { "name": "x-api-key", "value": "={{ $env.API_KEY }}" }
          ]
        }
      }
    }
  ],
  "connections": { "Manual Trigger": { "main": [[{ "node": "Authorized call", "type": "main", "index": 0 }]] } }
}
